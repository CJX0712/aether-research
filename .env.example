# 复制为 .env 按需填写。未配置的检索源会被自动跳过，不影响其它源。
# 所有凭证都只从环境变量读取，不要写进代码或提交。

# ── 模型（至少配一个）────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ── 检索（可选，配几个用几个）────────────────────────────────────
# Brave Search —— 英文主力，$5/千次
BRAVE_API_KEY=
# 博查 AI 搜索 —— 中文主力
BOCHA_API_KEY=
# Tavily —— 自带正文，SPA 页兜底
TAVILY_API_KEY=
# Exa —— 语义检索
EXA_API_KEY=
# 自建 SearXNG 实例 —— 零凭证兜底
SEARXNG_BASE_URL=

# ── 学术源 ──────────────────────────────────────────────────────
# arXiv / OpenAlex / Crossref 免凭证。
# 填了邮箱可进 OpenAlex 与 Crossref 的 polite pool（限速更宽松、更稳定）。
RESEARCH_MAILTO=
