{
  "name": "aether-research",
  "version": "0.1.0",
  "description": "Deep research you can audit. A durable, verifiable research agent built on AetherFlow.",
  "keywords": ["deep-research", "ai", "agent", "research", "citations", "typescript"],
  "license": "MIT",
  "author": "晨星 (Chenxing)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "aether-research": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE", "EVAL.md", "CHANGELOG.md", "CONTRIBUTING.md"],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run eval/",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "aetherflow": "github:CJX0712/aetherflow",
    "fast-xml-parser": "^5.11.1",
    "jsdom": "^30.1.0",
    "lucide-static": "^1.47.0",
    "normalize-url": "^9.0.1",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
